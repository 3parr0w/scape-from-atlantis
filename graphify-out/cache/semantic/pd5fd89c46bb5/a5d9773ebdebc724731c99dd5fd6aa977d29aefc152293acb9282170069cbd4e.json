{"nodes": [{"id": "readme", "label": "README (Escape from Atlantis Online)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_escape_from_atlantis_online", "label": "Escape from Atlantis Online Game", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Digital implementation of the board game Survive: Escape from Atlantis for 2-4 players, with local (single screen, turn-based) and online (each player on own device) modes."}, {"id": "readme_local_online_modes", "label": "Local & Online Game Modes", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_server_authority", "label": "Server as Source of Truth", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Game state lives only on the server. Client sends an action like {t:'movePerson',p:3,to:'7,5'}; the server validates and executes it via engine.apply and sends each player their own engine.view. Dice are rolled only by the server using a seed stored in state."}, {"id": "readme_hidden_info", "label": "Hidden Information Protection", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hidden info (tile contents on the board, opponents' piece numbers, opponents' hand tiles) never reaches other clients. Only the player who reveals a tile receives the reveal event. The defense window is shown to all involved players whether or not they hold a tile, so nobody can guess who has one."}, {"id": "readme_reconnect_token", "label": "Reconnect via localStorage Token", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each player has a token stored in browser localStorage. If the page closes or the internet drops, they return to the same seat via 'continue previous game' or automatically."}, {"id": "readme_websocket_protocol", "label": "WebSocket Protocol", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client to server: {type:'create',n,name}, {type:'join',code,name}, {type:'rejoin',code,token}, {type:'action',a}. Server to client: joined{code,seat,token}, lobby{code,n,names}, state{view,events,names,connected}, error{msg}."}, {"id": "readme_build_pipeline", "label": "esbuild + tsc Build Pipeline", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npm run build bundles the whole app with esbuild into a single self-contained file (public/index.html) and builds server and tests with tsc into dist/. shell.html is the page template with a /*BUNDLE*/ placeholder."}, {"id": "readme_mobile_layout", "label": "Mobile-First Layout", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thumb-friendly: status bar and buttons at the bottom, compact player score row on top, collapsible game log. Board pans with one finger, zooms with pinch or +/- buttons, \u2922 refits. In landscape the control panel moves beside the board. Touch targets at least 44px."}, {"id": "readme_svg_graphics", "label": "SVG Vector Graphics", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All pieces are vector SVG drawings, not emoji: people (player-colored), sailboat, sea serpent, shark, whale, safe island, anchor. They render identically on every device. Code lives in src/gfx.ts."}, {"id": "readme_webaudio_sfx", "label": "WebAudio Procedural Sound", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sound is synthesized with WebAudio in src/sfx.ts (no audio files). The \ud83d\udd0a button next to zoom toggles it and the choice is remembered in the browser. Infinite animations are disabled when the device has reduced-motion enabled."}, {"id": "readme_test_suite", "label": "Test Suite", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "engine-test.ts: 45 precise rule tests plus 200 random in-engine games. server-test.ts: input sanitization and room code structure. fuzz.ts: 300 full random games (must all finish without errors or tile-content leaks). online-test.ts: real server + 3 WebSocket clients, full networked game, mid-game disconnect/reconnect, secrets never reaching others. ui-smoke.ts: quick DOM-stub check of the built output without a browser."}, {"id": "readme_limitations", "label": "Current Limitations", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single server instance (room state in memory, saved to a file; multi-server needs shared storage like Redis). No login/accounts; anyone knowing the room code can join before start. Rooms idle 24h are cleaned. Optional rules not yet implemented."}, {"id": "readme_engine_module", "label": "src/engine.ts Game Rules Module", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Game rules; no DOM and no I/O (runs in both browser and Node), fully typed."}, {"id": "readme_ui_module", "label": "src/ui.ts UI Module", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interface: display and clicks only; handles both local and online modes."}, {"id": "readme_server_module", "label": "server.ts Room Server", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server: rooms, seats, reconnection, per-player views."}, {"id": "readme_gfx_module", "label": "src/gfx.ts Vector Graphics Module", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sfx_module", "label": "src/sfx.ts Sound Module", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_rooms_storage", "label": "data/rooms.json Room Persistence", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DATA_FILE env var changes the room save path (default data/rooms.json). On hosts with ephemeral disks, attach persistent storage so games survive restarts."}, {"id": "readme_dockerfile", "label": "Dockerfile Deployment", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any host running Node or Docker works (Render, Railway, Fly.io, a VPS). Start command npm start; port read from PORT env var; client auto-selects wss:// when the host provides HTTPS."}], "edges": [{"source": "readme", "target": "readme_escape_from_atlantis_online", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_local_online_modes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_build_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_mobile_layout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_svg_graphics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_webaudio_sfx", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_test_suite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_limitations", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_engine_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_ui_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score":